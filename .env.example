# Copy to .env  (never commit .env)
PORT=8787
SPOTIFY_CLIENT_ID=
# Home Assistant: Profile -> Security -> Long-lived access tokens
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Optional: Home Assistant's LAN address (192.168.1.50 or 192.168.1.50:8123). Used instead of HA_URL when set; can also be set in the control panel.
HA_LOCAL_IP=
# Optional: Host header sent to HA_LOCAL_IP (defaults to HA_URL's host). Needed when HA only answers for its public hostname.
HA_HOST=
# Optional: 1 = send HA calls over a persistent WebSocket instead of REST (falls back to REST if it drops).
HA_WS=
# Optional: path to a Chromium-based browser if auto-detect fails
BROWSER_PATH=
