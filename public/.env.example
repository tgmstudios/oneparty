# Required: long random string. The on-prem hub sends it as the x-admin-key header. Also put it in the hub's .env (PARTY_API_KEY).
ADMIN_KEY=
PORT=8080
# Where entries, votes, ratings and uploaded images are stored. Must be a persistent disk/volume in the cloud.
DATA_DIR=./data
# 1 when behind a proxy/CDN (sets Secure cookies and reads X-Forwarded-For)
TRUST_PROXY=0
